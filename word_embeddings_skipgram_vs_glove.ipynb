    "def compute_topic_coherence(model_wv, word_list):\n",
    "    sims = []\n",
    "    for i in range(len(word_list)):\n",
    "        for j in range(i + 1, len(word_list)):\n",
    "            w1, w2 = word_list[i], word_list[j]\n",
    "            sims.append(model_wv.similarity(w1, w2))\n",
    "    return np.mean(sims)\n",
    "\n",
    "coherence_records = []\n",
    "for dom, words in domain_keywords.items():\n",
    "    sg_coh = compute_topic_coherence(sg_wv, words)\n",
    "    gl_coh = compute_topic_coherence(glove_wv, words)\n",
    "    coherence_records.append({\n",
    "        \"Domain\": dom,\n",
    "        \"Skip-gram Coherence\": round(sg_coh, 4),\n",
    "        \"GloVe Coherence\": round(gl_coh, 4),\n",
    "        \"Difference (GloVe - SG)\": round(gl_coh - sg_coh, 4)\n",
    "    })\n",
    "\n",
    "coherence_df = pd.DataFrame(coherence_records)\n",
    "# Add mean row\n",
    "mean_sg = coherence_df[\"Skip-gram Coherence\"].mean()\n",
    "mean_gl = coherence_df[\"GloVe Coherence\"].mean()\n",
    "mean_row = pd.DataFrame([{\n",
    "    \"Domain\": \"Overall Average\",\n",
    "    \"Skip-gram Coherence\": round(mean_sg, 4),\n",
    "    \"GloVe Coherence\": round(mean_gl, 4),\n",
    "    \"Difference (GloVe - SG)\": round(mean_gl - mean_sg, 4)\n",
    "}])\n",
    "coherence_df = pd.concat([coherence_df, mean_row], ignore_index=True)\n",
    "print(coherence_df.to_string(index=False))\n",
    "\n",
    "# Plot Coherence Bar Chart\n",
    "fig, ax = plt.subplots(figsize=(10, 4.5))\n",
    "bar_width = 0.35\n",
    "indices = np.arange(len(coherence_records))\n",
    "\n",
    "ax.bar(indices - bar_width/2, [r[\"Skip-gram Coherence\"] for r in coherence_records], bar_width, label=\"Skip-gram (Corpus)\", color=\"#3498db\")\n",
    "ax.bar(indices + bar_width/2, [r[\"GloVe Coherence\"] for r in coherence_records], bar_width, label=\"GloVe (Pretrained 6B)\", color=\"#9b59b6\")\n",
    "\n",
