    "# Preprocessing pipeline implementation\n",
    "lemmatizer = WordNetLemmatizer()\n",
    "stop_words = set(stopwords.words(\"english\"))\n",
    "\n",
    "def preprocess_text(text: str) -> list[str]:\n",
    "    # Lowercase\n",
    "    text = text.lower()\n",
    "    # Strip URLs\n",
    "    text = re.sub(r\"https?://\\S+|www\\.\\S+\", \" \", text)\n",
    "    # Strip punctuation, digits, and special characters\n",
    "    text = re.sub(r\"[^a-z\\s]\", \" \", text)\n",
    "    # Tokenize\n",
    "    raw_tokens = text.split()\n",
    "    # Filter stopwords and short tokens, then lemmatize\n",
    "    cleaned_tokens = [\n",
    "        lemmatizer.lemmatize(token)\n",
    "        for token in raw_tokens\n",
    "        if token not in stop_words and len(token) > 2\n",
    "    ]\n",
    "    return cleaned_tokens\n",
    "\n",
    "# Apply preprocessing across the corpus\n",
    "df[\"Tokens\"] = df[\"Text\"].apply(preprocess_text)\n",
    "df[\"Cleaned_Text\"] = df[\"Tokens\"].apply(lambda x: \" \".join(x))\n",
    "df[\"Doc_Length\"] = df[\"Tokens\"].apply(len)\n",
    "\n",
    "# Verification sample\n",
    "sample_idx = 0\n",
    "print(f\"--- Document #{sample_idx} ({df['Domain'].iloc[sample_idx]}) ---\")\n",
    "print(\"Original Raw Text (first 200 chars):\")\n",
    "print(df[\"Text\"].iloc[sample_idx][:200].strip())\n",
    "print(\"\\nCleaned & Lemmatized Tokens (first 15 tokens):\")\n",
    "print(df[\"Tokens\"].iloc[sample_idx][:15])\n",
    "print(f\"\\nCorpus Token Statistics: Total tokens = {df['Doc_Length'].sum():,}, Mean doc length = {df['Doc_Length'].mean():.1f} tokens\")"
   ]
