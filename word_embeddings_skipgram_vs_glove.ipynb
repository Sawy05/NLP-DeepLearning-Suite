    "def get_document_centroid(tokens: list[str], model_wv, dim: int = 100) -> np.ndarray:\n",
    "    vectors = [model_wv[token] for token in tokens if token in model_wv]\n",
    "    if len(vectors) == 0:\n",
    "        return np.zeros(dim, dtype=np.float32)\n",
    "    return np.mean(vectors, axis=0)\n",
    "\n",
    "# Generate document matrix X for both embedding models\n",
    "X_skipgram = np.array([get_document_centroid(tokens, sg_wv, 100) for tokens in df[\"Tokens\"]])\n",
    "X_glove = np.array([get_document_centroid(tokens, glove_wv, 100) for tokens in df[\"Tokens\"]])\n",
    "y = df[\"Label\"].values\n",
    "\n",
    "# Perform stratified 80/20 train/test split\n",
    "X_train_sg, X_test_sg, y_train, y_test = train_test_split(\n",
    "    X_skipgram, y, test_size=0.20, random_state=42, stratify=y\n",
    ")\n",
    "X_train_gl, X_test_gl, _, _ = train_test_split(\n",
    "    X_glove, y, test_size=0.20, random_state=42, stratify=y\n",
    ")\n",
    "\n",
    "print(f\"Dataset split: {len(y_train)} training documents, {len(y_test)} test documents.\")"
   ]
