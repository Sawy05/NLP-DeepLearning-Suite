   "source": [
    "# Build an expanded stop words set\n",
    "custom_stop_words = set(ENGLISH_STOP_WORDS)\n",
    "\n",
    "def preprocess_text(text: str, stop_words: set = custom_stop_words) -> list:\n",
    "    \"\"\"\n",
    "    Preprocesses a raw text string:\n",
    "    - Lowercases text\n",
    "    - Strips non-alphabetic characters\n",
    "    - Tokenizes by whitespace\n",
    "    - Removes stop words and single-character tokens\n",
    "    \n",
    "    Parameters:\n",
    "        text (str): Input raw text.\n",
    "        stop_words (set): Set of stop words to filter out.\n",
    "        \n",
    "    Returns:\n",
    "        list: List of cleaned, normalized string tokens.\n",
    "    \"\"\"\n",
    "    # 1. Lowercase\n",
    "    text = text.lower()\n",
    "    # 2. Remove punctuation and numbers\n",
    "    text = re.sub(r'[^a-z\\s]', ' ', text)\n",
    "    # 3. Tokenize on whitespace\n",
    "    raw_tokens = text.split()\n",
    "    # 4. Filter stop words and length > 1\n",
    "    cleaned_tokens = [token for token in raw_tokens if token not in stop_words and len(token) > 1]\n",
    "    return cleaned_tokens\n",
    "\n",
    "# Apply preprocessing to dataset\n",
    "df['tokens'] = df['text'].apply(preprocess_text)\n",
    "df['cleaned_text'] = df['tokens'].apply(lambda tokens: ' '.join(tokens))\n",
    "df['raw_char_len'] = df['text'].apply(len)\n",
    "df['raw_word_len'] = df['text'].apply(lambda t: len(t.split()))\n",
    "df['clean_word_len'] = df['tokens'].apply(len)\n",
    "\n",
    "# Display before-and-after comparison\n",
    "sample_comparison = df[['text', 'cleaned_text', 'label']].head(6)\n",
    "for idx, row in sample_comparison.iterrows():\n",
    "    print(f\"[{row['label'].upper()}]\")\n",
    "    print(f\"  Raw:     {row['text']}\")\n",
    "    print(f\"  Cleaned: {row['cleaned_text']}\\n\")"
   ]
