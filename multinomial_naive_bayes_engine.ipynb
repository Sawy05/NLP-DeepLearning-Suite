     "text": [
      "Manual Multinomial Naive Bayes model trained successfully!\n",
      "Identified Classes: ['Entertainment' 'Politics' 'Sports' 'Technology']\n",
      "Learned Class Log Priors: [-1.5115 -1.3863 -1.7346 -1.0415]\n"
     ]
