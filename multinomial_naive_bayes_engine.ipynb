    "# Instantiate and fit Scikit-Learn's MultinomialNB\n",
    "sklearn_nb = MultinomialNB(alpha=1.0, fit_prior=True)\n",
    "sklearn_nb.fit(X_train, y_train)\n",
    "\n",
    "# Generate predictions\n",
    "sklearn_train_preds = sklearn_nb.predict(X_train)\n",
    "sklearn_test_preds = sklearn_nb.predict(X_test)\n",
    "\n",
    "# Check prediction equivalence\n",
    "train_match = np.array_equal(manual_train_preds, sklearn_train_preds)\n",
    "test_match = np.array_equal(manual_test_preds, sklearn_test_preds)\n",
    "\n",
    "print(\"=== Prediction Equivalence Verification ===\")\n",
    "print(f\"Training set predictions match 100%: {train_match}\")\n",
    "print(f\"Test set predictions match 100%:     {test_match}\")\n",
    "\n",
    "# Check numerical difference in posterior log probabilities\n",
    "manual_log_proba = manual_nb.predict_log_proba(X_test)\n",
    "sklearn_log_proba = sklearn_nb.predict_log_proba(X_test)\n",
    "max_abs_diff = np.max(np.abs(manual_log_proba - sklearn_log_proba))\n",
    "\n",
    "print(f\"Maximum absolute difference in log probabilities: {max_abs_diff:.2e}\")\n",
    "if max_abs_diff < 1e-12:\n",
    "    print(\">> The manual mathematical implementation matches Scikit-Learn to within machine precision!\")\n",
    "\n",
    "# Sample-by-sample test comparison table\n",
    "comparison_df = pd.DataFrame({\n",
    "    'Text Sample': [t[:50] + '...' if len(t) > 50 else t for t in test_df['text']],\n",
    "    'Ground Truth': y_test,\n",
    "    'Manual NB Pred': manual_test_preds,\n",
    "    'Sklearn NB Pred': sklearn_test_preds,\n",
    "    'Exact Match': manual_test_preds == sklearn_test_preds\n",
    "})\n",
    "comparison_df.reset_index(drop=True, inplace=True)\n",
    "display(comparison_df)"
   ]
