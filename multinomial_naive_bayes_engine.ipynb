   ],
   "source": [
    "class ManualMultinomialNB:\n",
    "    \"\"\"\n",
    "    A Pure Python/NumPy implementation of Multinomial Naive Bayes.\n",
    "    \n",
    "    Parameters:\n",
    "        alpha (float): Additive Laplace smoothing parameter (default=1.0).\n",
    "    \"\"\"\n",
    "    def __init__(self, alpha: float = 1.0):\n",
    "        self.alpha = float(alpha)\n",
    "        self.classes_ = None\n",
    "        self.class_log_prior_ = None\n",
    "        self.feature_log_prob_ = None\n",
    "        self.n_features_ = None\n",
    "        \n",
    "    def fit(self, X: np.ndarray, y: np.ndarray):\n",
    "        \"\"\"\n",
    "        Fit the Multinomial Naive Bayes classifier on training data.\n",
    "        \n",
    "        Parameters:\n",
    "            X (np.ndarray): Document-term count matrix of shape (n_samples, n_features).\n",
    "            y (np.ndarray): Target class labels of shape (n_samples,).\n",
    "        \"\"\"\n",
    "        self.classes_ = np.unique(y)\n",
    "        n_samples, self.n_features_ = X.shape\n",
    "        n_classes = len(self.classes_)\n",
    "        \n",
    "        self.class_log_prior_ = np.zeros(n_classes, dtype=np.float64)\n",
    "        self.feature_log_prob_ = np.zeros((n_classes, self.n_features_), dtype=np.float64)\n",
    "        \n",
    "        # Calculate priors and smoothed feature log probabilities\n",
    "        for idx, c in enumerate(self.classes_):\n",
    "            # Select subset of documents belonging to class c\n",
    "            X_c = X[y == c]\n",
    "            n_c = X_c.shape[0]\n",
    "            \n",
    "            # Prior: P(c) = N_c / N\n",
    "            self.class_log_prior_[idx] = np.log(n_c / n_samples)\n",
    "            \n",
    "            # Total word count in class c\n",
    "            total_words_c = np.sum(X_c)\n",
    "            \n",
    "            # Word frequencies in class c with Laplace smoothing (alpha)\n",
    "            word_counts_c = np.sum(X_c, axis=0) + self.alpha\n",
    "            denominator = total_words_c + self.alpha * self.n_features_\n",
    "            \n",
    "            # Feature log probability: log P(w|c)\n",
    "            self.feature_log_prob_[idx, :] = np.log(word_counts_c / denominator)\n",
    "            \n",
    "        return self\n",
    "\n",
    "    def predict_joint_log_likelihood(self, X: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"\n",
    "        Compute joint unnormalized log likelihood: log P(c) + sum_j x_j * log P(w_j | c).\n",
    "        \"\"\"\n",
    "        # Shape: (n_samples, n_classes) = X @ feature_log_prob_.T + class_log_prior_\n",
    "        return X @ self.feature_log_prob_.T + self.class_log_prior_\n",
    "\n",
    "    def predict_log_proba(self, X: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"\n",
    "        Compute numerically stable normalized posterior log probabilities using Log-Sum-Exp.\n",
    "        \"\"\"\n",
    "        jll = self.predict_joint_log_likelihood(X)\n",
    "        max_jll = np.max(jll, axis=1, keepdims=True)\n",
    "        # Log-Sum-Exp trick\n",
    "        log_sum_exp = max_jll + np.log(np.sum(np.exp(jll - max_jll), axis=1, keepdims=True))\n",
    "        return jll - log_sum_exp\n",
    "\n",
    "    def predict_proba(self, X: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"\n",
    "        Compute class probabilities P(c | d).\n",
    "        \"\"\"\n",
    "        return np.exp(self.predict_log_proba(X))\n",
    "\n",
    "    def predict(self, X: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"\n",
    "        Predict class label with maximum posterior probability.\n",
    "        \"\"\"\n",
    "        jll = self.predict_joint_log_likelihood(X)\n",
    "        best_indices = np.argmax(jll, axis=1)\n",
    "        return self.classes_[best_indices]\n",
    "\n",
    "# Instantiate and fit manual model\n",
    "manual_nb = ManualMultinomialNB(alpha=1.0)\n",
    "manual_nb.fit(X_train, y_train)\n",
    "\n",
    "# Generate predictions\n",
    "manual_train_preds = manual_nb.predict(X_train)\n",
    "manual_test_preds = manual_nb.predict(X_test)\n",
    "\n",
    "print(\"Manual Multinomial Naive Bayes model trained successfully!\")\n",
    "print(f\"Identified Classes: {manual_nb.classes_}\")\n",
    "print(f\"Learned Class Log Priors: {np.round(manual_nb.class_log_prior_, 4)}\")"
   ]
  },
