    "# 1. Diagnostic Words: Highest Likelihood P(w|c) per Class\n",
    "print(\"=== Top 8 Most Diagnostic Words per Category ===\")\n",
    "for idx, c in enumerate(manual_nb.classes_):\n",
    "    log_probs = manual_nb.feature_log_prob_[idx]\n",
    "    top_indices = np.argsort(log_probs)[::-1][:8]\n",
    "    top_words = [f\"{inv_vocab[i]} ({np.exp(log_probs[i]):.4f})\" for i in top_indices]\n",
    "    print(f\"\\n[{c.upper()}]:\")\n",
    "    print(\"  \" + \", \".join(top_words))\n",
    "\n",
    "# 2. Misclassified Sample Inspection\n",
    "test_misclassified = test_df[manual_test_preds != y_test]\n",
    "if len(test_misclassified) > 0:\n",
    "    print(f\"\\nTotal Misclassified Samples on Test Set: {len(test_misclassified)}\")\n",
    "    for idx, row in test_misclassified.iterrows():\n",
