   "source": [
    "# Compute per-class Precision, Recall, and F1-score\n",
    "def compute_metrics_per_class(y_true, y_pred, class_labels):\n",
    "    metrics = []\n",
    "    cm = confusion_matrix(y_true, y_pred, labels=class_labels)\n",
    "    for i, label in enumerate(class_labels):\n",
    "        tp = cm[i, i]\n",
    "        fp = np.sum(cm[:, i]) - tp\n",
    "        fn = np.sum(cm[i, :]) - tp\n",
    "        support = np.sum(cm[i, :])\n",
    "        \n",
    "        precision = tp / (tp + fp) if (tp + fp) > 0 else 0.0\n",
    "        recall = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n",
    "        f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0.0\n",
    "        \n",
    "        metrics.append({\n",
    "            'Category': label,\n",
    "            'Precision': precision,\n",
    "            'Recall': recall,\n",
    "            'F1-Score': f1,\n",
    "            'Support': support\n",
    "        })\n",
    "    df_metrics = pd.DataFrame(metrics)\n",
    "    return df_metrics\n",
    "\n",
    "metrics_df = compute_metrics_per_class(y_test, manual_test_preds, classes)\n",
    "\n",
    "# Calculate Macro and Weighted averages\n",
    "macro_row = {\n",
    "    'Category': 'Macro Average',\n",
    "    'Precision': metrics_df['Precision'].mean(),\n",
    "    'Recall': metrics_df['Recall'].mean(),\n",
    "    'F1-Score': metrics_df['F1-Score'].mean(),\n",
    "    'Support': metrics_df['Support'].sum()\n",
    "}\n",
    "weighted_row = {\n",
    "    'Category': 'Weighted Average',\n",
    "    'Precision': np.average(metrics_df['Precision'], weights=metrics_df['Support']),\n",
    "    'Recall': np.average(metrics_df['Recall'], weights=metrics_df['Support']),\n",
    "    'F1-Score': np.average(metrics_df['F1-Score'], weights=metrics_df['Support']),\n",
    "    'Support': metrics_df['Support'].sum()\n",
    "}\n",
    "\n",
    "metrics_summary_df = pd.concat([metrics_df, pd.DataFrame([macro_row, weighted_row])], ignore_index=True)\n",
    "\n",
    "# Format table\n",
    "formatted_metrics = metrics_summary_df.copy()\n",
    "formatted_metrics['Precision'] = formatted_metrics['Precision'].apply(lambda x: f\"{x:.4f}\")\n",
    "formatted_metrics['Recall'] = formatted_metrics['Recall'].apply(lambda x: f\"{x:.4f}\")\n",
    "formatted_metrics['F1-Score'] = formatted_metrics['F1-Score'].apply(lambda x: f\"{x:.4f}\")\n",
    "formatted_metrics['Support'] = formatted_metrics['Support'].astype(int)\n",
    "\n",
    "print(\"=== Per-Class Performance Metrics (Test Set) ===\")\n",
    "display(formatted_metrics)\n",
    "\n",
    "# Visualizing Per-Class Metrics\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "x = np.arange(len(classes))\n",
    "width = 0.25\n",
    "\n",
    "p_bars = ax.bar(x - width, metrics_df['Precision'], width, label='Precision', color='#4575b4', edgecolor='black')\n",
    "r_bars = ax.bar(x, metrics_df['Recall'], width, label='Recall', color='#74add1', edgecolor='black')\n",
    "f_bars = ax.bar(x + width, metrics_df['F1-Score'], width, label='F1-Score', color='#f46d43', edgecolor='black')\n",
    "\n",
    "ax.set_title('Figure 7: Per-Class Precision, Recall, and F1-Score (Test Set)', fontsize=14, fontweight='bold', pad=15)\n",
    "ax.set_xlabel('Topic Category', fontsize=12, labelpad=10)\n",
